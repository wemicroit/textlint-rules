{
  "name": "textlint-rule-frontmatter",
  "version": "0.0.0",
  "description": "A textlint rule plugin which performs document checks using the info provided in the frontmatter.",
  "keywords": [
    "textlintrule",
    "frontmatter"
  ],
  "license": "MIT",
  "author": "WeMicroIt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wemicroit/textlint-rules"
  },
  "type": "commonjs",
  "main": "lib/index.js",
  "directories": {
    "test": "test"
  },
  "files": [
    "lib/",
    "src/"
  ],
  "scripts": {
    "test": "textlint-scripts test",
    "build": "textlint-scripts build",
    "prepublish": "npm run --if-present build"
  },
  "devDependencies": {
    "@textlint/types": "15.7.1",
    "textlint-scripts": "15.7.1",
    "textlint-tester": "15.7.1"
  },
  "dependencies": {
    "js-yaml": "^5.2.1"
  }
}
